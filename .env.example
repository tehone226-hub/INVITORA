# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local ne doit JAMAIS être envoyé sur GitHub (il est ignoré par Git).

# Supabase (étape 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA : texte (Claude) et images (Gemini), côté serveur uniquement (étape 6)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Paiement SasPay (étape 9)
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=

# Adresse publique du site (ex. http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=
