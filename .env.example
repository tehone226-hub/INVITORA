# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local ne doit JAMAIS être envoyé sur GitHub (il est ignoré par Git).
# Sur Vercel : mêmes variables dans Project Settings > Environment Variables.

# --- Neon : base de données, connexion et API de données (console.neon.tech) ---
# Connexion SQL directe, rôle propriétaire (secret). Utilisée côté serveur uniquement.
DATABASE_URL=
# Neon > votre projet > Data API : adresse REST (se termine par /rest/v1)
NEON_DATA_API_URL=
# Neon > votre projet > Auth : adresse du serveur d'authentification (se termine par /auth)
NEON_AUTH_BASE_URL=
# Secret de signature des cookies de session : 32 caractères ou plus. Générez-le avec : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Site ---
# Adresse publique du site (http://localhost:3000 en local, https://votre-domaine en production)
NEXT_PUBLIC_SITE_URL=
# Comptes administrateurs (e-mails séparés par des virgules) : promus à leur connexion
ADMIN_EMAILS=

# --- IA : textes d'invitation rédigés par Gemini (côté serveur uniquement) ---
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Paiement SasPay ---
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=
# TESTS DE PAIEMENT UNIQUEMENT (règle 4) : force un petit montant, ex. 100. Laisser vide en production.
SASPAY_TEST_AMOUNT_XOF=
